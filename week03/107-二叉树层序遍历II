/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    vector<vector<int>> levelOrderBottom(TreeNode* root) {

        vector<vector<int>>ans;
        if(root==nullptr)
        return ans;
        TreeNode*cur=nullptr;
        constexpr int MAX_SIZE=1000;
        TreeNode*queue_arr[MAX_SIZE]={nullptr};
        int front_idx=0;
        int rear_idx=0;

        auto enqueue=[&](TreeNode*root)
        {
            queue_arr[rear_idx]=root;
            rear_idx=(rear_idx+1)%MAX_SIZE;
        };

        auto dequeue=[&]()->TreeNode*
        {
            TreeNode*node=queue_arr[front_idx];
            front_idx=(front_idx+1)%MAX_SIZE;
            return node;

        };

        auto queue_size=[&]()->int
        {
            return (rear_idx-front_idx+MAX_SIZE)%MAX_SIZE;
        };
        enqueue(root);


        while(queue_size()>0)
        {
            int level_size=queue_size();
            vector<int>level_arr;
            level_arr.reserve(level_size);
            
            for(int i=0;i<level_size;i++)
            {
                cur=dequeue();
                
                level_arr.push_back(cur->val);
                if(cur->left!=nullptr)
                enqueue(cur->left);
                if(cur->right!=nullptr)
                enqueue(cur->right);

            }
            ans.push_back(move(level_arr));
            
            

        }
        std::reverse(ans.begin(),ans.end());
        return ans;
    }
    

};
